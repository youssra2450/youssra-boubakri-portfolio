# Frontend build/dev variables (Vite). Copy to frontend/.env.local to override locally.
# Only variables prefixed with VITE_ are exposed to the browser code: never put secrets here.

# Public URL of the site, without trailing slash: canonical link, Open Graph / Twitter tags, JSON-LD.
# Local development: http://localhost:5173 (start.bat sets it automatically). Docker: build arg of docker compose.
VITE_SITE_URL=http://localhost:5173

# Base URL of the REST API as seen by the browser. Keep "/api" (same origin, proxied by Vite in development
# and by nginx in Docker) unless the API is hosted on another domain (then also set CORS_ORIGINS on the API).
VITE_API_BASE_URL=/api

# Development/preview server only: where Vite proxies /api, /robots.txt and /sitemap.xml.
# Default http://localhost:8000; start.bat sets it to the API port it starts.
# VITE_DEV_API_TARGET=http://localhost:8000
