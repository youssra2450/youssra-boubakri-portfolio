# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.py]
indent_size = 4
max_line_length = 110

[*.{ps1,psm1}]
indent_size = 4
end_of_line = crlf
charset = utf-8-bom

[*.{bat,cmd}]
end_of_line = crlf

[*.sh]
indent_size = 2
end_of_line = lf

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
