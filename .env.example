# =============================================================================================================
#  Portfolio — environment configuration (template)
#
#  Copy this file to ".env" at the repository root and adjust it. Never commit ".env".
#  * Windows one-click launcher (start.bat): creates ".env" from this file automatically, with a random
#    SECRET_KEY, and overrides DATABASE_URL / SITE_URL for the embedded database and the local site.
#  * Docker (docker compose up --build): read by compose for ${...} substitution and by the backend container.
#  * Manual setup: read by the API from the repository root (or backend/.env).
#  Empty values fall back to the defaults documented below.
# =============================================================================================================

# --- Application -----------------------------------------------------------------------------------------
# development | test | production. In production the placeholder SECRET_KEY below is refused and HSTS is sent.
ENVIRONMENT=development
APP_NAME=portfolio-api
APP_VERSION=1.0.0

# --- Security ----------------------------------------------------------------------------------------------
# Salt used to hash visitor IP addresses (rate limiting, spam protection). At least 32 characters.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-generate-a-random-value-of-at-least-32-characters

# --- Database (PostgreSQL) -----------------------------------------------------------------------------------
# Used by docker compose (db service) and by the embedded local database of start.bat
# (backend/scripts/local_db.py creates this role and database). Change the password in production.
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=portfolio
POSTGRES_DB=portfolio

# SQLAlchemy URL of the API, for a manual setup with a system PostgreSQL on port 5432.
# postgres:// and postgresql:// URLs (managed databases) are accepted and switched to the psycopg 3 driver.
# start.bat and docker compose set their own value (embedded database on port 5433 / "db" service).
DATABASE_URL=postgresql+psycopg://portfolio:portfolio@localhost:5432/portfolio

# Port of the embedded PostgreSQL when backend/scripts/local_db.py is run by hand (start.bat uses -DbPort).
# LOCAL_DB_PORT=5433

# Optional: run the backend tests against PostgreSQL instead of in-memory SQLite (read by pytest only).
# TEST_DATABASE_URL=postgresql+psycopg://portfolio:portfolio@localhost:5432/portfolio_test

# --- Web ---------------------------------------------------------------------------------------------------
# Public URL of the site, without trailing slash: robots.txt, sitemap.xml and the frontend build (Docker).
# Production example: https://youssra-boubakri.example   (start.bat uses http://localhost:5173 automatically)
SITE_URL=http://localhost:8080

# Origins allowed to call the API from a browser (comma separated). Only needed when the site and the API are
# on different domains; with Docker/nginx or the Vite dev proxy everything is same-origin.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost:8080

# Host port published by docker compose for the website.
FRONTEND_PORT=8080

# true when the API runs behind a reverse proxy (nginx in Docker): the client IP is read from X-Forwarded-For.
# docker compose forces true for the backend container.
TRUST_PROXY_HEADERS=false

# Interactive API documentation at /api/docs (Swagger UI), /api/redoc and /api/openapi.json.
DOCS_ENABLED=true

# --- Content -------------------------------------------------------------------------------------------------
# Public profile links, applied to the profile by the seed (python -m app.database.seed).
PORTFOLIO_GITHUB_URL=https://github.com/youssra2450
PORTFOLIO_LINKEDIN_URL=https://www.linkedin.com/in/youssra-boubakri-a4390b25b/

# Seed file (default: database/seed/portfolio.json in the repository, /app/seed/portfolio.json in Docker).
SEED_FILE=

# --- Contact form ----------------------------------------------------------------------------------------------
# The contact form appears on the site ONLY once e-mail forwarding is fully configured: EMAIL_PROVIDER is not
# "none", EMAIL_FROM and EMAIL_TO are set, plus SMTP_HOST (smtp) or RESEND_API_KEY (resend). Until then the site
# shows the e-mail, LinkedIn and GitHub cards only. Messages are also stored in the database (audit trail).
#
# Option A — Gmail SMTP (free):
#   1. Enable 2-Step Verification on the Google account, then create an "App password" (Google Account ->
#      Security -> App passwords). Use that 16-character password below, not the normal Gmail password.
#   2. EMAIL_PROVIDER=smtp, SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USE_TLS=true,
#      SMTP_USERNAME=<the Gmail address>, SMTP_PASSWORD=<the app password>,
#      EMAIL_FROM=<the same Gmail address>, EMAIL_TO=<the address that should receive the messages>
#
# Option B — Resend (https://resend.com, API key):
#   EMAIL_PROVIDER=resend, RESEND_API_KEY=re_..., EMAIL_FROM=<sender on a domain verified in Resend>,
#   EMAIL_TO=<recipient>
#
# Restart the API after changing these values (stop.bat then start.bat, or docker compose up -d).
EMAIL_PROVIDER=none
EMAIL_FROM=
EMAIL_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
RESEND_API_KEY=

# Contact form protection: max submissions per client IP (<count>/<second|minute|hour|day>) and minimum time
# in seconds between page load and submission (faster submissions are treated as bots).
RATE_LIMIT_CONTACT=5/hour
CONTACT_MIN_SUBMIT_SECONDS=3

# --- Logging ---------------------------------------------------------------------------------------------------
# CRITICAL | ERROR | WARNING | INFO | DEBUG ; LOG_JSON=true emits one JSON object per line (log collectors).
LOG_LEVEL=INFO
LOG_JSON=false
